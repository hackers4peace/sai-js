{
  "name": "interop",
  "private": true,
  "devDependencies": {
    "@dagger.io/dagger": "^0.19.10",
    "@solid/community-server": "8.0.0-alpha.2",
    "@types/node": "^22.10.10",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "jest-rdf": "^2.0.0",
    "likec4": "^1.59.3",
    "lint-staged": "^15.4.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.0.1",
    "tslib": "^2.8.1",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "prepare": "if [ \"$CI\" != \"true\" ]; then husky; fi",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "watch": "./node_modules/.bin/turbowatch turbowatch.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && oxfmt --check .",
    "typecheck": "for p in utils data-model application authorization-agent api-messages test-utils repl; do tsgo --noEmit -p packages/$p/tsconfig.json || exit 1; done"
  },
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "packages/*",
    "test",
    "docs/website"
  ],
  "lint-staged": {
    "*.{ts,js,vue}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "overrides": {
    "@solid/access-token-verifier": "github:elf-pavlik/access-token-verifier#cid"
  }
}
