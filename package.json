{
  "name": "interop",
  "private": true,
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.1.0",
    "@dagger.io/dagger": "^0.21.12",
    "@solid/community-server": "github:elf-pavlik/CommunitySolidServer#lws-sai",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "jest-rdf": "^2.0.0",
    "likec4": "^1.61.0",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rimraf": "^6.1.4",
    "tslib": "^2.9.1",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "prepare": "if [ \"$CI\" != \"true\" ]; then husky; fi",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "watch": "./node_modules/.bin/turbowatch turbowatch.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && oxfmt --check .",
    "typecheck": "for p in utils lws-auth data-model application authorization-agent api-messages test-utils repl; do tsc --noEmit -p packages/$p/tsconfig.json || exit 1; done",
    "publish:npm": "turbo run publish:npm --filter='./packages/*' --concurrency=1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*",
    "test",
    "docs/website"
  ],
  "lint-staged": {
    "*.{ts,js,vue}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
