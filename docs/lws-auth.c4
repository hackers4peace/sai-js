/*
 * LWS authorization — the spec flow, the decentralized variant, and what the
 * CSS fork in this repo actually does.
 *
 * Sources
 * - lws10-core §Authorization: https://w3c.github.io/lws-protocol/lws10-core/#authorization
 * - lws-auth/oidc.c4 — Identity Assertion JWT Authorization Grant variant
 * - CommunitySolidServer@lws-sai (99c208447)
 *     config/identity/lws/default.json            (AS endpoints, issuer = baseUrl)
 *     config/ldp/authentication/lws.json          (LwsAccessTokenExtractor)
 *     config/ldp/metadata-writer/writers/www-auth-lws.json  (challenge)
 *     config/ldp/metadata-writer/writers/lws-link.json      (Link: rel=lws#storage)
 * - SAI
 *     packages/components/config/{data,registry}.json import css:config/identity/lws/default.json
 *     packages/components/config/auth.json does NOT (auth is only the OIDC provider)
 *     packages/utils/src/lws-auth.ts        (client-side discovery + exchange)
 *     packages/components/src/SelfIssuedSession.ts, builders/sessionManager.ts
 *
 * The landscape lives in architecture.c4 (h4p.*), the per-user stacks in
 * temporal.c4 (Alice, Bob, App); this file only adds the LWS-specific parts.
 */

model {
  /*
   * A storage server MAY be its own authorization server
   * ("the authorization server may be the same server as the storage server").
   * SAI takes that single-entity case: every storage hosts the AS that issues
   * access tokens for *itself*, so RAS and RS collapse into one process.
   */
  extend h4p.Data {
    component LwsProtectedResourceMetadata 'Protected Resource Metadata' 'RFC 9728' {
      description '''
        `/.well-known/oauth-protected-resource/<storage path>`

        - `resource` — the *requested resource* URI, not the storage
        - `authorization_servers` — REQUIRED by LWS, here `["https://data/"]`

        `LwsProtectedResourceMetadataHttpHandler`
      '''
    }

    component LwsAuthorizationServer 'LWS authorization server' 'RFC 8693 token exchange' {
      description '''
        `css:config/identity/lws/default.json`, `issuer` = the server base URL.

        - `/.well-known/lws-configuration` → `LwsAuthorizationServerMetadataHttpHandler`
        - `/.well-known/lws/jwks` → `LwsJwkGenerator` (ES256, `CachedJwkGenerator`)
        - `/.well-known/lws/token` → `LwsTokenHttpHandler`

        `verifyStorage` rejects a `resource` that is not a storage hosted by this
        server (`invalid_target`) — the spec's "unknown or untrusted storage".
        A `DPoP` proof, when present, is verified (`htu`/`htm`) and its key
        thumbprint is forwarded to the verifier as `proofKeyThumbprint`.
      '''
    }

    component LwsAccessTokenValidation 'LWS access-token validation' 'LwsAccessTokenExtractor' {
      description '''
        `css:config/ldp/authentication/lws.json` — first handler of the
        `WaterfallCredentialsExtractor`, so an `Authorization: Bearer` token is
        never downgraded to an anonymous request.

        Checks: signature via the issuer's `jwks_uri` (cached), `iss`, `aud`
        exactly one value = the storage holding the target resource,
        `exp`/`nbf`/`iat` (±60 s). Failure → 401 `invalid_token`.
      '''
    }
  }

  extend h4p.Registry {
    component LwsAuthorizationServer 'LWS authorization server' 'registry' {
      description '''
        The registry server is the LWS authorization server of its own storages
        (`https://registry/alice/`), exactly as `h4p.Data` is for `https://data/<pod>/`:
        same `css:config/identity/lws/default.json`, plus the SAI override
        (`config/identity/id-jag-accept.json`) that adds the `id-jag` subject-token type.
      '''
    }
  }

  extend h4p.Auth {
    component SelfIssuedCredential 'Self-issued credential' 'at+jwt' {
      description '''
        `SelfIssuedSession` (`packages/components/src/SelfIssuedSession.ts`) with
        `EnvJwkGenerator(CSS_ENCODED_PRIVATE_JWK)`.

        `typ: at+jwt`, `iss: https://auth/`, `aud: "solid"`, `sub`/`webid` = agent,
        `client_id`/`azp` = client, `cnf.jkt` = DPoP key thumbprint.

        This — not an OpenID Connect ID Token — is what the suite and the
        authorization agents present as `subject_token`
        (`subject_token_type=…:id_token`), signed in-process with the shared key.
        The **UI** presents its own session access token instead
        (`…:access_token`, `aud` = `https://auth/`, `cnf.jkt` = the session key);
        the UAS mints no credentials of its own (`lws-auth` D15).
      '''
    }

    component IdJagTokenEndpoint 'UAS token exchange' 'ID-JAG' {
      description '''
        `IdJagRouter` + `IdJagTokenHandler`, `POST /.well-known/lws/token`.

        **Exchange 1 of 2.** `requested_token_type=…:id-jag`,
        `subject_token_type=…:id_token`, `audience=<resource AS>`, with a DPoP
        proof for the credential's `cnf.jkt`. Mints one ID-JAG per resource
        authorization server and never a storage access token.

        The UAS advertises no `/.well-known/lws-configuration` (`auth.json`
        imports no `css:config/identity/lws/default.json`), so clients use this
        well-known path directly.
      '''
    }
  }

  extend h4p.WebID {
    component WebIdDocument 'WebID / CID document' 'id' {
      description '''
        `https://id/alice` — the dereferenceable `sub` of the subject token. It
        carries `solid:oidcIssuer <https://auth/>`
        (`packages/data-model/src/templates/WebId.ts`), which is how the storage
        learns which OpenID Provider to trust. LWS's own
        `lws:OpenIdProvider` service link is not used by SAI fixtures.
      '''
    }
  }

  extend Bob {
    component RAS 'Resource Authorization Server' 'ras.bob.example' {
      description '''
        Role from `lws-auth/oidc.c4` (a separate AS next to the storage). **Not
        deployed by SAI** — `h4p.Data.LwsAuthorizationServer` fills this role.
      '''
    }

    component CID 'CID' 'id' {
      description '''
        Bob's controlled identifier (`https://id/bob`, served by `sai-id`). It is
        the `sub`/`webid` of every credential his UAS issues. In a federated
        deployment another UAS dereferences it to check that it designates Bob's
        UAS as his OpenID provider; in the single-`auth` test topology the issuer
        is trusted outright, so only the profile load inside claim derivation
        touches it.
      '''
    }
  }

  extend YoYo {
    component CID 'CID' 'id' {
      description '''
        YoYo's controlled identifier (`https://id/yoyo`, served by `sai-id`).
        Loaded twice in the impersonation chain: by YoYo's own UAS when its
        session bootstraps the profile (the registry set is **derived** from the
        id origin plus the account-storage endpoint record, not read from this
        document), and by ACME's AS when it verifies the re-issued ID-JAG (`sub`
        is now YoYo).
      '''
    }
  }

  // Subject-token validation hops (SAI's flavour of "validate all presented tokens")
  h4p.Data.LwsAuthorizationServer -> h4p.WebID.WebIdDocument 'dereference subject_token.sub' {
    technology 'HTTPS'
  }
  h4p.Data.LwsAuthorizationServer -> h4p.Auth.OP 'OIDC discovery + JWKS' {
    technology 'HTTPS'
  }
  h4p.Data.LwsProtectedResourceMetadata -> h4p.Data.LwsAuthorizationServer 'advertises' {
    technology 'authorization_servers: ["https://data/"]'
  }
  h4p.Data.LwsAccessTokenValidation -> h4p.Data.LwsAuthorizationServer 'jwks_uri (cached key set)' {
    technology 'HTTPS'
  }
  App.UI -> h4p.Data.LwsAccessTokenValidation 'LWS requests'
  h4p.Data.LwsAccessTokenValidation -> h4p.Data.SaiPolicyEngine 'credentials {agent, client}'
}

views {
  /*
   * 1. The generic flow. SAI implements every numbered hop, but with the AS and
   *    the storage in one process, and with a self-issued subject token.
   */
  dynamic view lws-authorization-spec {
    title: 'LWS authorization (spec)'

    include App
    include App.UI
    include h4p.Data with { title 'Acme' }, h4p.Data.LwsProtectedResourceMetadata, h4p.Data.LwsAuthorizationServer, h4p.Data.LwsAccessTokenValidation
    include h4p.Auth, h4p.Auth.OP, h4p.WebID.WebIdDocument

    style App {
      color: gray
    }
    style h4p.Data {
      color: sky
    }

    App.UI -> h4p.Data 'GET /storage_1/photos/img.jpg' {
      notes'''
        #### Unauthorized request

        Any protected resource needs an access token generated by a trusted
        authorization server; a client finds it by *failing first*.

        >[!NOTE]
        > Who the client is (`client_id`) is not part of this exchange — it
        > arrives later, inside the subject token.
      '''
    }

    h4p.Data -> App.UI '401 Unauthorized' {
      notes'''
        #### The 401 carries the discovery values

        ```http
        HTTP/2 401 Unauthorized
        Link: <https://storage.example/storage_1>; rel="https://www.w3.org/ns/lws#storage"
        WWW-Authenticate: Bearer resource_metadata="https://storage.example/.well-known/oauth-protected-resource/storage_1/photos/img.jpg",
                          error="invalid_token"
        ```

        >[!IMPORTANT]
        > Both headers are MUSTs: `resource_metadata` (RFC 9728 §5.1) **and** a
        > `Link` identifying the storage that contains the resource.

        SAI emits both: `LwsWwwAuthMetadataWriter` adds
        `resource_metadata`, `as_uri`, `realm`, `error`;
        `LwsLinkMetadataWriter` adds the `rel="…lws#storage"` link.

        >[!TIP]
        > `as_uri` and `realm` are earlier-draft parameters, kept for older
        > clients. SAI's own client reads `realm` — the spec wants the `Link`
        > header (see the last note of this view).
      '''
    }

    App.UI -> h4p.Data.LwsProtectedResourceMetadata 'GET resource_metadata URL' {
      notes'''
        #### Protected resource metadata

        ```json
        {
          "resource": "https://storage.example/storage_1/photos/img.jpg",
          "authorization_servers": ["https://authorization.example"]
        }
        ```

        >[!IMPORTANT]
        > `resource` identifies the *requested resource*, not the storage;
        > `authorization_servers` is REQUIRED and holds issuer identifiers.
      '''
    }

    h4p.Data.LwsProtectedResourceMetadata -> App.UI '200 application/json' {
      notes'''
        #### Discovery validation (client side)

        Before requesting a token the client MUST verify, all against the URI
        that produced the 401:

        1. `resource_metadata` has the same scheme + authority as the request
        2. `resource` in the document is *identical* to the requested URI
        3. the `Link` storage description's `StorageRoot` `serviceEndpoint` has
           the same scheme + authority

        >[!WARNING]
        > `packages/utils/src/lws-auth.ts` implements 1–3 only partially: it
        > fetches `authorization_servers` from `resource_metadata` but never
        > compares `resource`, never dereferences the storage description, and
        > takes the storage from the challenge `realm` instead of the `Link`
        > header.
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'GET /.well-known/lws-configuration' {
      notes'''
        #### Authorization server metadata (RFC 8414)

        LWS requires this exact path, and adds
        `subject_token_types_supported` / `subject_identifier_types_supported`.
      '''
    }

    h4p.Data.LwsAuthorizationServer -> App.UI '200 AS metadata' {
      notes'''
        ```json
        {
          "issuer": "https://authorization.example",
          "token_endpoint": "https://authorization.example/token",
          "jwks_uri": "https://authorization.example/jwks",
          "grant_types_supported": ["urn:ietf:params:oauth:grant-type:token-exchange"],
          "subject_token_types_supported": [
            "urn:ietf:params:oauth:token-type:jwt",
            "urn:ietf:params:oauth:token-type:id_token"
          ],
          "subject_identifier_types_supported": ["did:web", "did:key", "https"]
        }
        ```

        CSS emits the same shape, with `token_endpoint`/`jwks_uri` joined onto
        the issuer (`…/.well-known/lws/token`, `…/.well-known/lws/jwks`).
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'POST token_endpoint (token exchange)' {
      notes'''
        #### OAuth 2.0 Token Exchange — the only grant LWS uses

        ```http
        POST /token HTTP/1.1
        Content-Type: application/x-www-form-urlencoded

        grant_type=urn:ietf:params:oauth:grant-type:token-exchange
        &resource=https%3A%2F%2Fstorage.example%2Fstorage_1
        &subject_token=eyJ0eXAiOiJhcytqd3QiLCJhbGciO...
        &subject_token_type=urn:ietf:params:oauth:token-type:id_token
        ```

        >[!IMPORTANT]
        > `resource` is REQUIRED and must be the **storage** URI from the `Link`
        > header — it becomes the `aud` of the access token. Unknown or
        > untrusted storage → reject.

        Optional extras in CSS: a `DPoP` proof, whose key thumbprint is checked
        against the subject token's `cnf.jkt`.
      '''
    }

    parallel 'authorization server validates the subject token' {
      h4p.Data.LwsAuthorizationServer -> h4p.WebID.WebIdDocument 'dereference sub (CID / WebID)' {
        notes'''
          [LWS OIDC — Authentication Credential Validation](https://w3c.github.io/lws-protocol/lws10-authn-openid/#validation):
          the document's `id` MUST equal `sub` and name the issuer as its
          `OpenIdProvider` (or, for Solid-OIDC tokens, `solid:oidcIssuer`).
        '''
      }
      h4p.Data.LwsAuthorizationServer -> h4p.Auth.OP 'fetch server metadata + JWKS' {
        notes'''
          The issuer named by the credential document is then discovered and its
          keys fetched to verify the subject token's signature.

          >[!NOTE]
          > This is the part `oidc.c4` draws as `RAS -> CID` and
          > `RAS -> EU.UAS`; the spec leaves the verification method to the
          > `subject_token_type` verifier.
        '''
      }
    }

    h4p.Data.LwsAuthorizationServer -> App.UI '200 {access_token, token_type, expires_in}' {
      notes'''
        ```json
        { "access_token": "eyJ0eXAiOiJhcytqd3QiLCJhbGciOiJFUzI1NiIs...", "token_type": "Bearer", "expires_in": 300 }
        ```

        #### RFC 9068 `at+jwt`

        REQUIRED claims: `sub` (agent URI), `iss` (the AS), `client_id` (URI),
        `aud` (must include the `resource` value — a storage), `exp`, `iat`,
        `jti`. Lifetimes SHOULD be ≤ 300 s (CSS: `lifetime: 300`).

        Errors follow RFC 6749 §5.2 (`invalid_request`, `invalid_target`, …).
      '''
    }

    App.UI -> h4p.Data.LwsAccessTokenValidation 'GET /storage_1/photos/img.jpg + Bearer' {
      notes'''
        #### Presentation

        `Authorization: Bearer <at+jwt>` (RFC 6750). One token per storage, not
        per resource.
      '''
    }

    h4p.Data.LwsAccessTokenValidation -> h4p.Data.SaiPolicyEngine 'authenticated {agent, client}' {
      notes'''
        #### Validation, then authorization

        Signature (`jwks_uri`), `iss`, `aud` = the storage of the target, and the
        temporal claims are checked first; an invalid token is a 401 with
        `resource_metadata` + `error="invalid_token"`.

        >[!IMPORTANT]
        > A valid token only proves identity — it never bypasses the policy
        > engine (WAC/ACP/grant evaluation happens after this hop).
      '''
    }

    h4p.Data.SaiPolicyEngine -> h4p.Data.LwsAccessTokenValidation 'decision' {
      notes'''
        allow → the operation proceeds; deny → `403` (a policy decision is not a
        credential problem, so it must not be a 401).
      '''
    }

    h4p.Data.LwsAccessTokenValidation -> App.UI '200 / 403'
  }

  /*
   * 2a. What SAI runs by default, read off trace 72728215… (2026-11-13): one
   *     exchange with the storage's own authorization server (RAS == RS, no
   *     ID-JAG). Payload and token attributes quoted below come from that trace
   *     with OTEL_CAPTURE_HEADERS + OTEL_CAPTURE_TOKENS + OTEL_CAPTURE_BODIES.
   */
  dynamic view lws-authorization {
    title: 'LWS authorization (implemented, single exchange)'

    description '''
      Trace `7272821567363e13efe9f1e8cb17857a` — `policy-engine.test.ts` ›
      `protected resources (scope all, modes all)` ›
      `authenticated request (authorized agent / authorized client)` › `can Read`.
    '''

    include App
    include App.UI
    include h4p.Data with { title 'Acme' }, h4p.Data.LwsProtectedResourceMetadata, h4p.Data.LwsAuthorizationServer, h4p.Data.LwsAccessTokenValidation, h4p.Data.SaiPolicyEngine, h4p.Data.SPARQLEndpoint
    include h4p.Auth, h4p.Auth.SelfIssuedCredential, h4p.Auth.OP
    include h4p.WebID, h4p.WebID.WebIdDocument

    style App {
      color: gray
    }
    style h4p.Data {
      color: sky
    }
    style h4p.Auth {
      color: green
    }

    App.UI -> h4p.Data 'GET /alice-work/k3pqsb (no credential)' {
      notes'''
        #### Unauthenticated probe

        `createLwsFetch` sends the first request without `Authorization`; the
        transport span carries `http.request.header.accept: text/turtle` and an
        empty `http.request.body` (`OTEL_CAPTURE_HEADERS` / `OTEL_CAPTURE_BODIES`).
      '''
    }

    h4p.Data -> App.UI '401 Unauthorized' {
      notes'''
        ```http
        HTTP/2 401 Unauthorized
        Link: <https://data/alice-work/>; rel="https://www.w3.org/ns/lws#storage"
        WWW-Authenticate: Bearer resource_metadata="https://data/.well-known/oauth-protected-resource/alice-work/k3pqsb",
                          as_uri="https://data/", realm="https://data/alice-work/", error="invalid_token"
        ```

        The body is captured (`http.response.body`). Note the 401 already ran the
        policy engine: **3 × `POST /reg-alice/sparql` + 6 ×
        `POST /data-alice-work/sparql`** — the challenge needs the storage
        (`realm`), which the engine resolves.
      '''
    }

    App.UI -> h4p.Data.LwsProtectedResourceMetadata 'GET /.well-known/oauth-protected-resource/alice-work/k3pqsb' {
      notes'''
        200; `http.response.body` =
        `{"resource": "…/alice-work/k3pqsb", "authorization_servers": ["https://data/"]}`.
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'GET /.well-known/lws-configuration'

    h4p.Data.LwsAuthorizationServer -> App.UI '200 {issuer, token_endpoint, jwks_uri}' {
      notes'''
        `token_endpoint` = `https://data/.well-known/lws/token`,
        `jwks_uri` = `https://data/.well-known/lws/jwks`,
        `subject_token_types_supported` = [`jwt`, `id_token`, `id-jag`] (C2).
      '''
    }

    h4p.Auth.SelfIssuedCredential -> App.UI 'self-issued at+jwt' {
      notes'''
        `iss: https://auth/`, `aud: "solid"`, `webid`, `azp`, `cnf.jkt` — signed
        with the UAS key. Recorded as `sai.token.subject.*` on the client span.
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'POST /.well-known/lws/token' {
      notes'''
        ```http
        grant_type=urn:ietf:params:oauth:grant-type:token-exchange
        &subject_token_type=urn:ietf:params:oauth:token-type:id_token
        &subject_token=<at+jwt>
        &resource=https://data/alice-work/
        ```

        `sai.lws.request.body` (tokens redacted as `<jwt:…>`) and
        `sai.lws.response.body` on the server span.
      '''
    }

    parallel 'subject-token verification (inside the exchange)' {
      h4p.Data.LwsAuthorizationServer -> h4p.Data.SPARQLEndpoint 'POST /data-alice-work/sparql (verifyStorage)'
      h4p.Data.LwsAuthorizationServer -> h4p.WebID.WebIdDocument 'GET https://id/alice (deref sub)' {
        notes'''
          `sub` is not in `trustedIssuers` of the storage → the document is
          dereferenced and `solid:oidcIssuer` must name the token's `iss`.
        '''
      }
      h4p.Data.LwsAuthorizationServer -> h4p.Auth.OP 'GET /.well-known/openid-configuration'
      h4p.Data.LwsAuthorizationServer -> h4p.Auth.OP 'GET /.oidc/jwks' {
        notes'''
          ```json
          sai.jwks.url   = "/.oidc/jwks"
          sai.jwks.count = 1
          sai.jwks.keys  = [{ "kty": "EC", "crv": "P-256", "alg": "ES256", "kid": "5Q5ZOPHv…", "use": "sig" }]
          ```

          Parsed from the served document (the key set is public material); the
          raw body is in `http.response.body`.
        '''
      }
    }

    h4p.Data.LwsAuthorizationServer -> App.UI '200 {access_token: at+jwt, token_type: Bearer, expires_in: 300}' {
      notes'''
        `iss: https://data/`, `aud: https://data/alice-work/`, `sub: https://id/alice`,
        `client_id: https://data/test-client/public/id`.
      '''
    }

    App.UI -> h4p.Data.LwsAccessTokenValidation 'GET /alice-work/k3pqsb + Bearer'

    h4p.Data.LwsAccessTokenValidation -> h4p.Data.SaiPolicyEngine 'credentials {agent, client}'

    parallel 'policy engine (unchanged by LWS)' {
      h4p.Data.SaiPolicyEngine -> h4p.WebID.WebIdDocument 'fetchJsonLd https://id/alice ×3' {
        notes'''
          Each lookup is a `sai-jsonld` span with `sai.jsonld.raw` and
          `sai.jsonld.framed` (payload capture, OTEL_CAPTURE_BODIES).
        '''
      }
      h4p.Data.SaiPolicyEngine -> h4p.Data.SPARQLEndpoint '~20 SPARQL queries (registrations, grants, modes)'
    }

    h4p.Data.SaiPolicyEngine -> h4p.Data.LwsAccessTokenValidation 'allow (Read)'
    h4p.Data.LwsAccessTokenValidation -> App.UI '200 text/turtle'
  }

  /*
   * 2b. The two-step chain (C1–C4), read off trace 48e23f27… (2026-11-13): the
   *     credential is exchanged at the **user's** authorization server for one
   *     ID-JAG per storage AS (`aud`), and each storage trades its grant for a
   *     bearer access token. Opt-in today via
   *     `buildLwsFetch(webid, clientId, { idJag: true })`.
   */
  dynamic view lws-authorization-id-jag {
    title: 'LWS authorization (implemented, ID-JAG)'

    description '''
      Trace `48e23f2782273bc80811a099f444dee2` — `/test` `lws-auth.test.ts` with
      two storages (`data` and `registry`): the four `sai.lws.*` spans appear
      twice, once per resource authorization server.
    '''

    include h4p.Auth, h4p.Auth.SelfIssuedCredential, h4p.Auth.OP
    include h4p.Auth.IdJagTokenEndpoint
    include App
    include App.UI
    include h4p.Data with { title 'Acme' }, h4p.Data.LwsAuthorizationServer, h4p.Data.LwsAccessTokenValidation
    include h4p.Registry, h4p.Registry.SPARQLEndpoint

    style App {
      color: gray
    }
    style h4p.Auth {
      color: green
    }
    style h4p.Data {
      color: sky
    }
    style h4p.Registry {
      color: red
    }

    App.UI -> h4p.Auth.IdJagTokenEndpoint 'POST /.well-known/lws/token (requested_token_type=id-jag)' {
      notes'''
        #### Span `sai.lws.request-id-jag` (client)

        ```http
        grant_type=urn:ietf:params:oauth:grant-type:token-exchange
        &requested_token_type=urn:ietf:params:oauth:token-type:id-jag
        &audience=https://data/
        &subject_token=<session access token>
        &subject_token_type=urn:ietf:params:oauth:token-type:access_token
        DPoP: <proof for cnf.jkt>
        ```

        Attributes: `sai.lws.audience`, `sai.lws.client_auth_method: none`,
        `sai.token.subject.*`, `sai.lws.request.body`, `sai.lws.response.body`.
      '''
    }

    h4p.Auth.IdJagTokenEndpoint -> App.UI '200 {issued_token_type: id-jag, token_type: N_A, expires_in: 300}' {
      notes'''
        #### Span `sai.lws.issue-id-jag` (auth)

        DPoP proof verified (`sai.lws.dpop_proof: true`), subject token validated
        against this server (`trustedIssuers`), grant signed with the Solid-OIDC
        key (`/.oidc/jwks`). `sai.token.id-jag.*` carries
        `typ=oauth-id-jag+jwt`, `aud=https://data/`, `client_id`, `jti`, `exp`.
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'POST /.well-known/lws/token (subject_token_type=id-jag)' {
      notes'''
        #### Span `sai.lws.exchange-access-token` (client)

        `resource=https://data/alice-work/`, `subject_token=<ID-JAG>`. The ID-JAG
        is cached per **authorization server**, the access token per **storage**
        (`createLwsFetch`), so a second request to this storage costs one round
        trip and nothing else.
      '''
    }

    h4p.Data.LwsAuthorizationServer -> h4p.Auth.OP 'discovery + JWKS' {
      notes'''
        #### Span `sai.lws.verify-id-jag` (storage)

        `typ` pinned to `oauth-id-jag+jwt`, `aud` must name this AS, signature
        verified via the issuer's JWKS (`sai.jwks.*` on the serving span),
        `jti`/`exp` checked. Rejections carry `sai.lws.error`.
      '''
    }

    h4p.Data.LwsAuthorizationServer -> App.UI '200 {access_token: at+jwt, aud=storage}'

    App.UI -> h4p.Data.LwsAccessTokenValidation 'GET /alice-work/k3pqsb + Bearer'

    parallel 'second storage, second authorization server' {
      App.UI -> h4p.Auth.IdJagTokenEndpoint 'POST /.well-known/lws/token (audience=https://registry/)' {
        notes'''
          A **separate** grant: a grant minted for `https://data/` is refused by
          the registry's token endpoint (`invalid_request`).
        '''
      }
      App.UI -> h4p.Registry.LwsAuthorizationServer 'POST /.well-known/lws/token (resource=https://registry/alice/)' {
        notes'''
          The same four-span chain repeats with `aud=https://registry/` — one
          chain per resource authorization server, visible side by side in the trace.
        '''
      }
    }

    App.UI -> h4p.Registry 'GET /alice/vzp6ky + Bearer' {
      notes'''
        403, not 401: the grant and the access token were accepted; the
        structural registry then denies this client by policy.
      '''
    }
  }

  /*
   * 3. C2 impersonation (`docs/plans/id-jag.md`): the app names a storage and
   *    Bob's UAS derives the claim from the delegated grant it holds; the next
   *    UAS re-issues it under the VISIBLE actor (YoYo) — Bob, the client's
   *    identity in the claim, the actor chain and the original claim ids all
   *    disappear before ACME's AS sees anything. The single-hop view above
   *    explains the endpoints this reuses.
   */
  dynamic view lws-impersonation {
    title: 'LWS impersonation (implemented, C2)'
    description '''
      **SAI capture, 2026-11-17** (`/test` `impersonation.test.ts` ›
      `Bob -> YoYo -> ACME hides Bob and the delegated grant references`,
      trace `dfc9f2c9…`, 3.4 s, dagger `--tempo-endpoint`). One trace holds the
      whole chain: the app's OIDC sign-in (discovery 30 ms, authorize 318 ms,
      code → token 104 ms), **hop 1 with claim derivation** (696 ms — Bob's UAS
      authenticates to Bob's registry and reads the grants), the impersonation
      hop (723 ms — the claim is checked against the mirrored subject grants and
      YoYo's assigner registry), the `sai.lws.verify-id-jag` at each receiving
      server (6 ms at YoYo's UAS, 51 ms at ACME's AS) and the storage read
      (188 ms).

      The app presents the **access token of its own OIDC session**: `auth` issues
      it with `aud` = `https://auth/` (the UAS that verifies it) and
      `cnf.jkt` = the app's DPoP key, and the app sends it as a
      `…:access_token` subject token. There is no separate credential endpoint and
      nothing is self-issued with `CSS_ENCODED_PRIVATE_JWK`.

      The app never builds the claim: it sends `audience` (the UAS),
      `resource` (the storage) and that token, and Bob's UAS adds the grant as
      `access`. The grant is **seed data**, not a test fixture write:
      `https://registry/yoyo/q7w2nz` (YoYo → Bob, `SelectedFromRegistry`,
      `https://data/acme-rnd/`) in `environments/data/registry.trig`, **mirrored
      into Bob's registry-pod dataset at seed time** (`applyReciprocalMirrors`, the
      offline equivalent of the runtime `updateReciprocalMirror`). With no matching
      grant the UAS mints an identity-only ID-JAG instead of inventing a claim.

      The client is the **test client** (`https://data/test-client/public/id`, its
      metadata document served by `data`), so `client_id` is the app on the
      credential — not `agentId(webid)` and not the UAS. In the trace it is
      `sai-test` (`App.UI`).

      Roles, not processes: one `auth.docker` process plays Bob's UAS *and*
      YoYo's UAS (both ID-JAGs have `iss=https://auth/`) and is the OpenID
      provider for both, so no separate provider box exists — each UAS answers
      its own discovery and `/.oidc/jwks`. Likewise each party's CID is its own
      document — the traced flow dereferences `YoYo.CID`, and the federated half
      (step 10, not traced) would dereference `Bob.CID`.

      **What this topology flattens** (the notes, not just the arrows, say which):

      - hop 1 and hop 2 post to the *same* `/.well-known/lws/token` — only `aud`
        tells them apart; federated they are Bob's and YoYo's UAS;
      - YoYo's UAS verifies an ID-JAG whose `iss` is itself, so it skips the
        CID + JWKS lookup: steps 10–11 show that federated half and are marked
        **not traced**;
      - the reciprocal mirror is **pre-applied by the fixture seed**
        (`applyReciprocalMirrors`), so the runtime `updateReciprocalMirror`
        activity never runs in this trace;
      - ACME's AS, storage and policy engine are one process (`h4p.Data`), so there
        is no AS → storage hop — and `storageOrigins` trusts the whole `data`
        origin, i.e. one AS serves every pod, not just `acme-rnd`;
      - all CIDs are served by the one `sai-id` (`https://id/<handle>`), so their
        hosting is not per-party here (the *fetch* in step 16 is still real).

      ACME's AS is the LWS authorization server of `h4p.Data` (`https://data/`)
      and the storage is `https://acme-rnd.data.docker/`.

      `sai.token.id-jag.*` is captured on all four spans; the `access` claims
      quoted below are decoded from `sai.token.id-jag.claims` for this run
      (repeated `uid` and policy-level convenience fields omitted).
    '''

    include App, Bob, YoYo
    include App.UI, Bob.UAS, Bob.Registry, Bob.CID, YoYo.UAS, YoYo.Registry, YoYo.CID
    include h4p.Data with { title 'Acme' }, h4p.Data.LwsAuthorizationServer, h4p.Data.LwsAccessTokenValidation, h4p.Data.SaiPolicyEngine

    style App {
      color: gray
    }

    style Bob {
      color: green
    }

    style YoYo {
      color: indigo
    }

    style h4p.Data {
      color: sky
    }

    App.UI -> Bob.UAS 'GET /.well-known/openid-configuration — OIDC discovery' {
      notes'''
      #### GET /.well-known/openid-configuration — OIDC discovery
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > Bob's UAS is also his OpenID provider — no separate provider element

      >[!TIP]
      > `oauth4webapi` (`createBrowserSession`) discovers the endpoints once;
      > `issuer` must equal this URL. The client's metadata document
      > (`https://data/test-client/public/id`) is fetched by the OP during the
      > authorize request — served by `data` from the fixture.

      ```http
      GET https://auth.docker/.well-known/openid-configuration
      Accept: application/json
      ```
      ---

      ```http
      HTTP/1.1 200 OK
      Content-Type: application/json
      ```
      '''
    }

    App.UI -> Bob.UAS 'GET /.oidc/auth — code + PKCE + dpop_jkt' {
      notes'''
      #### GET /.oidc/auth — code + PKCE + dpop_jkt
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > Auth: none yet — this *is* the sign-in

      >[!TIP]
      > the code is bound to the app's key (`dpop_jkt`), so the token request
      > needs a `DPoP` proof for it (RFC 9449 §10)

      ```http
      GET https://auth.docker/.oidc/auth
        ?client_id=https%3A%2F%2Fdata%2Ftest-client%2Fpublic%2Fid
        &redirect_uri=https%3A%2F%2Fdata%2Ftest-client%2Fpublic%2Fid
        &response_type=code&scope=openid+webid+offline_access
        &state=…&nonce=…
        &code_challenge=…&code_challenge_method=S256
        &dpop_jkt=i4j-vhsHyf9SgdTvZL-XlsNf3JOg3zO-4FgukUohUX4
      ```

      The OP has no session, so the response is `303` to its own interaction
      pages; `test/oidc-client.ts` drives them like a browser would, posting the
      controls each page advertises:

      | step | request | then |
      | --- | --- | --- |
      | sign-in | `POST /.account/login/password/` `{email, password}` | `200 {location}` → `GET` resume → `303` |
      | WebID picker | `POST /.account/oidc/pick-webid/` `{webId, remember}` | `200 {location}` → `GET` resume → `303` |
      | consent | `POST /.account/oidc/consent/` | `200 {location}` → `GET` resume → `303` to the client |

      (78 ms, 8 ms and 6 ms; the `GET` resumes are 102 / 108 / 98 ms.)

      **Where the identity comes from.** The picker's `GET` returns the WebIDs
      linked to the signed-in account (`WebIdStore.findLinks`, the `webIdLink`
      records of `bob@yoyodyne.example` → `https://id/bob`), and its `POST` stores
      the pick as the OIDC session's `accountId`. That value — not the CID document
      — is what the OP later puts in `sub`/`webid`; nothing fetches
      `https://id/bob` during the sign-in.
      '''
    }

    Bob.UAS -> App.UI '303 redirect_uri?code=…&state=…&iss=https://auth/' {
      notes'''
      #### 303 redirect_uri?code=…&state=…&iss=https://auth/
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!TIP]
      > `oauth4webapi.validateAuthResponse` checks `state` and `iss` before the
      > code is redeemed; the test never follows this redirect (no browser)

      ```http
      HTTP/1.1 303 See Other
      Location: https://data/test-client/public/id
        ?code=…&state=…&iss=https%3A%2F%2Fauth.docker%2F
      ```
      '''
    }

    App.UI -> Bob.UAS 'POST /.oidc/token — code + verifier + DPoP' {
      notes'''
      #### POST /.oidc/token — code + verifier + DPoP
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > Auth: PKCE `code_verifier` + a `DPoP` proof for `dpop_jkt`

      ```http
      POST https://auth.docker/.oidc/token
      Content-Type: application/x-www-form-urlencoded
      DPoP: <proof for i4j-vhsH…>

      grant_type=authorization_code
      &code=…
      &redirect_uri=https://data/test-client/public/id
      &client_id=https://data/test-client/public/id
      &code_verifier=…
      ```
      '''
    }

    Bob.UAS -> App.UI '200 {access_token, id_token} — the access token is the credential' {
      notes'''
      #### 200 {access_token, id_token} — the access token is the credential
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      ```http
      HTTP/1.1 200 OK
      Content-Type: application/json
      ```

      ```json
      {
        "access_token": "<at+jwt>",
        "id_token": "<jwt>",
        "token_type": "DPoP",
        "expires_in": 3600,
        "scope": "openid webid"
      }
      ```

      `access_token`, decoded (`sai.token.subject.*` on hop 1's span):
      ```json
      {
        "iss": "https://auth/",
        "aud": "https://auth/",
        "sub": "https://id/bob",
        "webid": "https://id/bob",
        "client_id": "https://data/test-client/public/id",
        "cnf": { "jkt": "i4j-vhsHyf9SgdTvZL-XlsNf3JOg3zO-4FgukUohUX4" },
        "jti": "i1MhbbzyKipCCOMQ9yUGRNDncUG41KzU3EakaXp2nK4",
        "iat": 1794876407,
        "exp": 1794880007
      }
      ```
      No separate mint: this **is** the LWS credential. `aud` is the UAS itself, so
      the token is only usable there (not at a storage, not at another AS), and
      `cnf.jkt` is the app's key from `dpop_jkt` — hop 1 has to prove it.
      `client_id` names the app, which is what keeps the app's identity in ID-JAG #1.
      `sub`/`webid` come from the pick in step 2; the OP answers from its stored
      session and never fetches `https://id/bob` here.
      '''
    }

    App.UI -> Bob.UAS 'POST /.well-known/lws/token — resource=<storage>, subject_token=<access token>' {
      notes'''
      #### POST /.well-known/lws/token — resource=<storage>, subject_token=<access token>
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > the app requests **no claim**. It names the business object — `resource`,
      > the storage holding the data — and the UAS finds the grants the user has
      > for that storage and client

      >[!TIP]
      > span `sai.lws.issue-id-jag` (**696 ms**,
      > `sai.lws.access.derived=true`, `sai.lws.access.storage=https://data/acme-rnd/`).
      > Derivation runs when there is no `access` parameter, the subject token is
      > not an ID-JAG, and `resource` is present. `DPoP` proves the credential's
      > `cnf.jkt` (`sai.lws.dpop_proof=true`).

      ```http
      POST https://auth.docker/.well-known/lws/token
      Content-Type: application/x-www-form-urlencoded
      DPoP: <proof for i4j-vhsH…>

      grant_type=urn:ietf:params:oauth:grant-type:token-exchange
      &requested_token_type=urn:ietf:params:oauth:token-type:id-jag
      &audience=https://auth/
      &resource=https://data/acme-rnd/
      &subject_token=<session access token: 50rcv4IOl_4P>
      &subject_token_type=urn:ietf:params:oauth:token-type:access_token
      ```
      No `access` field and no JSON here — the UAS adds the claim (next steps).
      '''
    }

    Bob.UAS -> Bob.Registry 'find the grants for the client + storage (registry-pod dataset)' {
      notes'''
      #### find the grants for the client + storage (registry-pod dataset)
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > one ID-JAG carries one delegation edge. An app-specific grant (user → this
      > client) wins; otherwise the narrowest received edge is taken —
      > `SelectedFromRegistry` > `Inherited` > `AllFromRegistry` > `AllFromAgent`

      >[!TIP]
      > the UAS authenticates as Bob first: `GET /bob/` → `401` → discovery →
      > `POST /.well-known/lws/token` (100 ms) → `200` (109 ms), then `GET /bob/`
      > again for the registry set — `~470 ms` before the first grant read

      ```http
      POST http://fuseki:3030/reg-bob/sparql    // 12 grant queries (+ registry reads)
      ```
      Matches the seeded `https://registry/yoyo/q7w2nz` (YoYo → Bob,
      `SelectedFromRegistry`, `https://data/acme-rnd/`). That graph reaches
      `reg-bob` through the reciprocal mirror the test fixture seeds
      (`applyReciprocalMirrors`, copying the linked registration's graphs and its
      grants into the grantee's dataset). The claim is that grant's own ODRL, ids
      included; nothing is invented.

      With no matching grant the UAS issues an **identity-only** ID-JAG (no
      `access`), which the next UAS refuses.
      '''
    }

    Bob.UAS -> App.UI 'ID-JAG #1 — derived claim, aud=YoYo.UAS, sub=bob, client_id=test-client' {
      notes'''
      #### ID-JAG #1 — derived claim, aud=YoYo.UAS, sub=bob, client_id=test-client
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!TIP]
      > `sai.token.id-jag.*` on the same `sai.lws.issue-id-jag` span

      ```http
      HTTP/1.1 200 OK
      Content-Type: application/json
      ```

      ```json
      {
        "issued_token_type": "urn:ietf:params:oauth:token-type:id-jag",
        "access_token": "<ID-JAG #1: a03f6596>",
        "token_type": "N_A",
        "expires_in": 300
      }
      ```

      decoded (header `typ=oauth-id-jag+jwt`, `kid=5Q5ZOPHv…`):
      ```json
      {
        "iss": "https://auth/",
        "aud": "https://auth/",
        "sub": "https://id/bob",
        "client_id": "https://data/test-client/public/id",
        "@context": "https://www.w3.org/ns/solid/interop-context/v1/odrl-id-jag-context",
        "access": [{
          "id": "urn:uuid:199c923b-2b67-4eac-997e-0b12f59c8de8",
          "type": ["http://www.w3.org/ns/odrl/2/Agreement"],
          "profile": "http://www.w3.org/ns/solid/interop#AccessProfile",
          "permission": [{
            "id": "urn:uuid:60e67784-d389-40df-b05f-0b5dcb7a2b62",
            "assignee": "https://id/bob",
            "action": ["http://www.w3.org/ns/odrl/2/read"],
            "target": {
              "id": "urn:uuid:0e00a1c2-63e4-4f9f-9d7b-6ecedd5e4787",
              "owner": "https://id/acme",
              "storage": "https://data/acme-rnd/",
              "type": ["http://www.w3.org/ns/odrl/2/Asset"],
              "source": ["https://data/acme-rnd/pbh2yw"],
              "partOf": ["https://data/acme-rnd/reb39k"]
            }
          }],
          "scopeOfGrant": "http://www.w3.org/ns/solid/interop#SelectedFromRegistry",
          "registeredShapeTree": "https://data/shapetrees/trees/Project",
          "assignee": "https://id/bob"
        }],
        "iat": 1794876408,
        "exp": 1794876708,
        "jti": "a03f6596-efd0-425a-8dae-b67919b6e640"
      }
      ```
      Still the **hidden** pair: `sub` = Bob, `client_id` = the app, claim
      `assignee` = Bob and **no `assigner`**, the grant's own `urn:uuid` ids, no
      `act`. The ids survive unchanged from the seed grant; only the next hop
      replaces them.
      '''
    }

    App.UI -> YoYo.UAS 'POST /.well-known/lws/token — subject_token=ID-JAG #1, resource=<storage>' {
      notes'''
      #### POST /.well-known/lws/token — subject_token=ID-JAG #1, resource=<storage>
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > no `access` parameter: an ID-JAG subject token plus a request claim is
      > refused (`invalid_request`) — the claim rides the incoming ID-JAG

      >[!NOTE]
      > in this environment this is the **same URL as step 6** (`auth` serves Bob's
      > and YoYo's token endpoints); federated, step 6 goes to Bob's UAS and this
      > one to YoYo's, and the ID-JAG's `aud` is the latter's identifier.

      >[!TIP]
      > span `sai.lws.issue-id-jag` (723 ms) with `sai.lws.verify-id-jag` as its
      > child (6 ms) — verify, subject-plane lookup, assigner-registry check and
      > re-issue all in one request

      ```http
      POST https://auth.docker/.well-known/lws/token
      Content-Type: application/x-www-form-urlencoded

      grant_type=urn:ietf:params:oauth:grant-type:token-exchange
      &requested_token_type=urn:ietf:params:oauth:token-type:id-jag
      &audience=https://data/
      &resource=https://data/acme-rnd/
      &subject_token=<ID-JAG #1>
      &subject_token_type=urn:ietf:params:oauth:token-type:id-jag
      ```
      No `DPoP` on this hop — the ID-JAG's `aud` is the restriction
      (`sai.lws.dpop_proof` is absent).
      '''
    }

    YoYo.UAS -> Bob.CID 'GET https://id/bob — resolve the issuer (federated)' {
      notes'''
      #### GET https://id/bob — resolve the issuer (federated)
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!WARNING]
      > not from this trace — architectural. Here Bob's UAS and YoYo's UAS are the
      > same `auth` process, so `iss` is in `trustedIssuers` and nothing is fetched:
      > the whole check is the local `sai.lws.verify-id-jag` span (6 ms, discovery +
      > JWKS against itself).

      Federated, the incoming ID-JAG's `sub` is Bob and its `iss` is **Bob's** UAS.
      `IdJagSubjectTokenVerifier` dereferences `https://id/bob` and requires the
      document to designate that issuer as its OpenID provider
      (`lws:OpenIdProvider` with `serviceEndpoint` = `iss`, or `solid:oidcIssuer`),
      so YoYo's UAS never trusts a claim just because it arrived over TLS.

      ```http
      GET https://id/bob
      Accept: application/ld+json, application/json;q=0.9, text/turtle;q=0.8
      ```
      '''
    }

    YoYo.UAS -> Bob.UAS 'discovery + JWKS (federated)' {
      notes'''
      #### discovery + JWKS (federated)
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!WARNING]
      > not from this trace — architectural, the partner of the previous step

      With the issuer resolved, `IdJagSubjectTokenVerifier` runs OpenID Connect
      discovery at **Bob's** UAS and verifies the ID-JAG's ES256 signature with
      its `jwks_uri` (the discovered `issuer` must equal `iss`). In this run those
      two calls go to `https://auth/…` — its own provider — which is why they show
      up as 2 + 2 ms children of `sai.lws.verify-id-jag`.

      In both environments the order is fixed: `aud` must name this AS,
      `typ` is pinned to `oauth-id-jag+jwt`, then the issuer is established, then
      `jti`/`exp` are checked.
      '''
    }

    YoYo.UAS -> YoYo.Registry 'find the grant backing the claim (DelegatedAccessClaimValidator)' {
      notes'''
      #### find the grant backing the claim (DelegatedAccessClaimValidator)
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > the incoming ID-JAG's `iss` is *this* UAS, so a self-signed claim is never
      > trusted on its own — the subject's mirrored grant must resolve to a matching
      > grant in the assigner registry

      >[!TIP]
      > the UAS authenticates to the subject's registry first: `GET /bob/` → `401`
      > → `/.well-known/oauth-protected-resource/bob/` →
      > `/.well-known/lws-configuration` → `POST /.well-known/lws/token` (26 ms) →
      > `200` (104 ms), then reads the mirrored grants. It repeats the exchange with
      > the assigner's registry (`/yoyo/`, 24 ms → 87 ms) to confirm the match.

      ```http
      POST http://fuseki:3030/reg-bob/sparql      // mirrored subject grants
      POST http://fuseki:3030/reg-yoyo/sparql     // assigner grant registry
      ```
      Every claim policy must match a grant in `hasGrantRegistry` on its semantic
      fields and ODRL permissions (ids excluded), with `grantedBy` = the recovered
      assigner, grantee = the incoming subject/client and the same storage; an
      `inheritsFromGrant` must itself exist in the registry.

      Failure is `400 invalid_grant`:
      ```
      no existing grant covers the delegated claim
      ```
      '''
    }

    YoYo.UAS -> App.UI 'ID-JAG #2 — sub=yoyo, aud=https://data/, client_id=https://auth/' {
      notes'''
      #### ID-JAG #2 — sub=yoyo, aud=https://data/, client_id=https://auth/
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > the visible actor is recovered from the backing grant's `grantedBy`
      > (`DelegatedAccessClaimValidator`), then `visibleSubject` uses that value;
      > the outgoing client is the issuing UAS (`issuedClient = this.issuer.issuer`).
      > `rewriteAccessClaim` re-issues the claim with `assignee = YoYo` (the token
      > subject), **no `assigner`**, and fresh `urn:uuid` ids

      ```http
      HTTP/1.1 200 OK
      Content-Type: application/json
      ```

      ```json
      {
        "issued_token_type": "urn:ietf:params:oauth:token-type:id-jag",
        "access_token": "<ID-JAG #2>",
        "token_type": "N_A",
        "expires_in": 300
      }
      ```

      decoded (`sai.lws.impersonation=true`):
      ```json
      {
        "iss": "https://auth/",
        "aud": "https://data/",
        "sub": "https://id/yoyo",
        "client_id": "https://auth/",
        "@context": "https://www.w3.org/ns/solid/interop-context/v1/odrl-id-jag-context",
        "access": [{
          "id": "urn:uuid:1984da14-9da6-4c21-a10e-e4daf42c5f20",
          "type": ["http://www.w3.org/ns/odrl/2/Agreement"],
          "profile": "http://www.w3.org/ns/solid/interop#AccessProfile",
          "assignee": "https://id/yoyo",
          "permission": [{
            "id": "urn:uuid:0f2d11d6-3799-43bb-8bfc-2066000204ff",
            "assignee": "https://id/yoyo",
            "action": ["http://www.w3.org/ns/odrl/2/read"],
            "target": {
              "id": "urn:uuid:ac76aeb8-3ec4-41d9-ad7a-2cdcdacdfe99",
              "owner": "https://id/acme",
              "storage": "https://data/acme-rnd/",
              "type": ["http://www.w3.org/ns/odrl/2/Asset"],
              "source": ["https://data/acme-rnd/pbh2yw"],
              "partOf": ["https://data/acme-rnd/reb39k"]
            }
          }],
          "scopeOfGrant": "http://www.w3.org/ns/solid/interop#SelectedFromRegistry",
          "registeredShapeTree": "https://data/shapetrees/trees/Project"
        }],
        "iat": 1794876409,
        "exp": 1794876709,
        "jti": "442bea6a-084c-4ced-8f5a-54e507f3d35d"
      }
      ```
      Fresh `urn:uuid` ids for the policy, the permission and the target; the
      claim is narrowed to the one ACME project, has **no `assigner`**, and is
      assigned to `https://id/yoyo` (the token subject). **No `act`** —
      impersonation drops the hidden actor chain.
      '''
    }

    App.UI -> h4p.Data.LwsAuthorizationServer 'POST /.well-known/lws/token — subject_token=ID-JAG #2' {
      notes'''
      #### POST /.well-known/lws/token — subject_token=ID-JAG #2
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!TIP]
      > the app redeems the visible ID-JAG at ACME's AS — the grant is bound to the
      > **AS** (`aud=https://data/`), not to a storage; `resource` narrows it to
      > one storage

      ```http
      POST https://data.docker/.well-known/lws/token
      Content-Type: application/x-www-form-urlencoded

      grant_type=urn:ietf:params:oauth:grant-type:token-exchange
      &subject_token=<ID-JAG #2>
      &subject_token_type=urn:ietf:params:oauth:token-type:id-jag
      &resource=https://data/acme-rnd/
      ```
      '''
    }

    h4p.Data.LwsAuthorizationServer -> YoYo.CID 'GET https://id/yoyo — dereference sub' {
      notes'''
      #### GET https://id/yoyo — dereference sub
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!IMPORTANT]
      > `sub` is now YoYo, so ACME dereferences **YoYo's** CID — never Bob's

      >[!TIP]
      > this is the check YoYo's UAS skips in steps 10–11 only because `iss` is
      > itself. `data` is a different server from `auth`, so it cannot shortcut:
      > it resolves the issuer through the subject document, then discovery + JWKS.

      Inside `sai.lws.verify-id-jag` (51 ms): `sai-id` answered `GET /yoyo` `200`
      in 17 ms. Bob's document is not fetched by ACME at all.
      '''
    }

    h4p.Data.LwsAuthorizationServer -> YoYo.UAS 'discovery + JWKS' {
      notes'''
      #### discovery + JWKS
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      Also inside `sai.lws.verify-id-jag`: `GET https://auth/.well-known/openid-configuration`
      (8 ms) and `GET https://auth/.oidc/jwks` (2 ms) — YoYo's UAS is its own
      provider, the discovered `issuer` must equal the ID-JAG's `iss`, and the
      JWKS supplies `kid=5Q5ZOPHv…` for the ES256 signature.

      `sai.lws.audience=https://data/`, `sai.lws.subject_id=https://id/yoyo`,
      `sai.lws.client_id=https://auth/`, `sai.lws.access.storage=https://data/acme-rnd/`.
      '''
    }

    h4p.Data.LwsAuthorizationServer -> App.UI 'access token — sub=yoyo, client_id=https://auth/, aud=storage' {
      notes'''
      #### access token — sub=yoyo, client_id=https://auth/, aud=storage
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      ```http
      HTTP/1.1 200 OK
      Content-Type: application/json
      ```

      The test asserts the decoded token (`sai.token.access.*` is not emitted
      server-side — CSS's `LwsTokenHttpHandler` owns the exchange; the response body
      is not captured):
      ```json
      {
        "iss": "https://data/",
        "aud": "https://data/acme-rnd/",
        "sub": "https://id/yoyo",
        "client_id": "https://auth/",
        "@context": "https://www.w3.org/ns/solid/interop-context/v1/odrl-id-jag-context",
        "access": [ <the rewritten claim, verbatim> ]
      }
      ```
      '''
    }

    App.UI -> h4p.Data.LwsAccessTokenValidation 'GET /acme-rnd/pbh2yw + Bearer' {
      notes'''
      #### GET /acme-rnd/pbh2yw + Bearer
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      ```http
      GET https://acme-rnd.data.docker/pbh2yw
      Accept: text/turtle
      Authorization: Bearer <access token>
      ```
      '''
    }

    h4p.Data.LwsAccessTokenValidation -> h4p.Data.SaiPolicyEngine 'claim-first decision (claim + registries)' {
      notes'''
      #### claim-first decision (claim + registries)
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      >[!TIP]
      > `h4p.Data` serves both the AS and the storage endpoint, so the decision runs
      > in the process that answered the token exchange — 185 ms inside
      > `data.docker` (`sai-data`), no second server hop

      Observed reads: `GET https://id/yoyo` (15 ms) then `22` SPARQL queries —
      `15` on `data-acme-rnd` (the resource + its registration) and `7` on
      `reg-acme` (the owner's registries). The token's `access` claim is evaluated
      **first**, so the claim's narrowed `source` (`pbh2yw`) / `partOf` (`reb39k`)
      bound the decision.
      '''
    }

    h4p.Data.SaiPolicyEngine -> App.UI '200 text/turtle — the narrowed project' {
      notes'''
      #### 200 text/turtle — the narrowed project
      >[!NOTE]
      >impersonation.test.ts > Bob -> YoYo -> ACME hides Bob and the delegated grant references

      ```http
      HTTP/1.1 200 OK
      Content-Type: text/turtle
      ```
      ### Checks

      #### String matching — on ID-JAG #2 and on the access token
      * no `https://id/bob` anywhere
      * no the app's `client_id` (`https://data/test-client/public/id`)
      * no `"act"` claim (impersonation drops the hidden actor chain)

      #### Compare with request
      * `sub` — `https://id/yoyo`
      * `client_id` — `https://auth/`
      * `assigner` — omitted from the claim
      * `assignee` — `https://id/yoyo`, equal to the token `sub`
      * `scopeOfGrant`, `registeredShapeTree`, `storage`, `source` — unchanged
      '''
    }
  }

  /*
   * 4. The decentralized variant lws-auth/oidc.c4 draws: a separate UAS and
   *    RAS, and an ID-JAG in between — NOT what SAI implements (2b is the
   *    in-repo ID-JAG, with the storage as its own RAS).
   */
  dynamic view lws-id-jag {
    title: 'Identity Assertion JWT Authorization Grant (not implemented)'

    description '''
      `lws-auth/oidc.c4` builds on LWS core §Authorization but keeps the
      authorization server **separate** from the resource server and adds an
      Identity Assertion JWT Authorization Grant
      ([draft-ietf-oauth-identity-assertion-authz-grant](https://www.ietf.org/archive/id/draft-ietf-oauth-identity-assertion-authz-grant-01.html)):
      the user's own UAS exchanges its ID Token for an ID-JAG scoped to a peer's
      RAS, and the RAS trades that ID-JAG for a storage access token. Two
      exchanges, two servers.
    '''

    include Alice, Bob, App
    include App.UI, App.CID, Alice.UAS, Bob.RAS, Bob.Data
    include h4p.WebID.WebIdDocument

    style Alice {
      color: green
    }
    style Bob {
      color: blue
    }
    style App {
      color: gray
    }

    App.UI -> Alice.UAS 'GET /authorize?response_type=code&client_id=…&redirect_uri=…' {
      notes'''
        SSO at the user's own UAS. The UAS fetches the client metadata from
        `client_id` and checks `redirect_uris` contains `redirect_uri`.
      '''
    }
    Alice.UAS -> App.CID 'GET /id (client metadata)'
    App.CID -> Alice.UAS '200 {client_id, client_name, redirect_uris, scope, grant_types}'
    Alice.UAS -> App.UI '302 redirect_uri?code=…'
    App.UI -> Alice.UAS 'POST /token (authorization_code)' {
      notes'''
        ID Token for the client:

        ```json
        { "sub": "https://id.alice.example", "aud": ["https://uas.alice.example", "https://decentphotos.example/id"],
          "azp": "https://decentphotos.example/id", "iss": "https://uas.alice.example", "jti": "…", "iat": …, "exp": … }
        ```

        >[!IMPORTANT]
        > `aud` lists **both** the OP and the client, and `azp` is present —
        > validation rules `oidc.c4` reuses from LWS OIDC.
      '''
    }
    Alice.UAS -> App.UI '200 ID Token (+ refresh token)'

    App.UI -> Bob.Data 'GET /garfield.png' {
      notes'''
        No credential yet — the request exists to discover the storage's
        authorization server.
      '''
    }
    Bob.Data -> App.UI '401 WWW-Authenticate: Bearer as_uri="https://ras.bob.example", realm="https://pod.bob.example"'

    App.UI -> Alice.UAS 'POST /token (token-exchange → ID-JAG)' {
      notes'''
        ```http
        grant_type=urn:ietf:params:oauth:grant-type:token-exchange
        &requested_token_type=urn:ietf:params:oauth:token-type:id-jag
        &resource=https://ras.bob.example
        &subject_token_type=urn:ietf:params:oauth:token-type:id_token
        &subject_token=<ID Token>
        &client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer
        &client_assertion=<private_key_jwt>
        ```

        `resource` sets the ID-JAG's `aud`; the client authenticates with
        `private_key_jwt`.
      '''
    }
    Alice.UAS -> App.UI '200 ID-JAG (typ=oauth-id-jag+jwt, aud=https://ras.bob.example)' {
      notes'''
        Carries `sub` (the user's WebID), `client_id`, `auth_time`, `amr` —
        identity asserted by the user's own UAS, for one specific RAS.
      '''
    }

    App.UI -> Bob.RAS 'POST /token (token-exchange → access token)' {
      notes'''
        ```http
        grant_type=urn:ietf:params:oauth:grant-type:token-exchange
        &resource=https://pod.bob.example
        &subject_token=<ID-JAG>
        &subject_token_type=urn:ietf:params:oauth:token-type:id-jag
        ```

        The RAS must resolve the ID-JAG's `iss` to a trusted OpenID Provider
        before issuing anything.
      '''
    }
    parallel 'RAS establishes trust in the ID-JAG issuer' {
      Bob.RAS -> h4p.WebID.WebIdDocument 'GET https://id.alice.example (CID)'
      Bob.RAS -> Alice.UAS 'GET /.well-known/oauth-authorization-server → jwks_uri'
    }
    Bob.RAS -> App.UI '200 at+jwt {sub, iss: https://ras.bob.example, client_id, aud: https://pod.bob.example}'
    App.UI -> Bob.Data 'GET /garfield.png (Authorization: Bearer)'
    Bob.Data -> App.UI '200 image/png'

    opt 'what SAI does instead' {
      App.UI -> Bob.Data 'POST /.well-known/lws/token' {
        notes'''
          One exchange, straight to the storage that hosts the resource:
          `subject_token` = the self-issued credential, `resource` = that same
          storage, and `Bob.Data` is also the issuer of the access token
          (`Bob.RAS` does not exist). No `id-jag` string appears anywhere in
          `sai-js` or the CSS fork.
        '''
      }
      Bob.Data -> App.UI '200 at+jwt {iss: https://data/, aud: https://data/}'
    }
  }

  view lws of h4p.Data {
    title: 'LWS endpoints on a storage server'

    include h4p.Data with { title 'Acme' }, h4p.Data.LwsProtectedResourceMetadata, h4p.Data.LwsAuthorizationServer, h4p.Data.LwsAccessTokenValidation, h4p.Data.SaiPolicyEngine
    include h4p.Auth.OP, h4p.WebID.WebIdDocument
    include App.UI

    style h4p.Data {
      color: sky
    }
  }
}
