{
  "installCommand": "npm install && npm install --prefix examples/vuejectron",
  "buildCommand": "cd examples/vuejectron && npx --no-install vite build && node scripts/vercel.js",
  "outputDirectory": "examples/vuejectron/dist",

  "rewrites": [
    {
      "source": "/id",
      "destination": "/id.jsonld"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/id.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json"
        }
      ]
    }
  ]
}
