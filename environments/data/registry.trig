    a interop:AccessNeedDescription ;
    interop:inAccessDescriptionSet <https://data/test-client/public/descriptions-en> ;
    interop:hasAccessNeed <https://data/test-client/public/access-needs#need-task> ;
    skos:prefLabel "Access to Tasks allows Projectron to identify and manage the work to be done in a given Project."@en .

