GRAPH <https://data/test-client/public/access-needs> {
  <https://data/test-client/public/access-needs#need-group-pm>
    a interop:AccessNeedGroup ;
    interop:accessNecessity interop:accessRequired ;
    interop:accessScenario interop:PersonalAccess ;
    interop:authenticatesAs interop:SocialAgent ;
    interop:hasAccessDescriptionSet
      <https://data/test-client/public/descriptions-en> ,
      <https://data/test-client/public/descriptions-es> ;
    interop:hasAccessNeed <https://data/test-client/public/access-needs#need-project> .

  <https://data/test-client/public/access-needs#need-project>
    a interop:AccessNeed ;
    interop:registeredShapeTree shapetrees:Project ;
    interop:accessNecessity interop:AccessRequired ;
    interop:accessMode acl:Read, acl:Create, acl:Update, acl:Delete .

  <https://data/test-client/public/access-needs#need-task>
    a interop:AccessNeed ;
    interop:registeredShapeTree shapetrees:Task ;
    interop:accessNecessity interop:AccessRequired ;
    interop:accessMode acl:Read, acl:Create, acl:Update, acl:Delete ;
    interop:inheritsFromNeed <https://data/test-client/public/access-needs#need-project> .

  <https://data/test-client/public/access-needs#need-image>
    a interop:AccessNeed ;
    interop:registeredShapeTree shapetrees:Image ;
    interop:accessNecessity interop:AccessOptional ;
    interop:accessMode acl:Read, acl:Create, acl:Update, acl:Delete ;
    interop:inheritsFromNeed <https://data/test-client/public/access-needs#need-project> .

  <https://data/test-client/public/access-needs#need-file>
    a interop:AccessNeed ;
    interop:registeredShapeTree shapetrees:File ;
    interop:accessNecessity interop:AccessOptional ;
    interop:accessMode acl:Read, acl:Create, acl:Update, acl:Delete ;
    interop:inheritsFromNeed <https://data/test-client/public/access-needs#need-project> .

  <https://data/test-client/public/descriptions-en>
    interop:usesLanguage "en"^^xsd:language .

  <https://data/test-client/public/descriptions-es>
    interop:usesLanguage "es"^^xsd:language .
}

