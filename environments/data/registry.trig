GRAPH <meta:https://registry/acme/> {
  <https://registry/acme/>
    a interop:RegistrySet, ldp:Resource, space:Storage;
    interop:hasSocialAgentRegistry <https://registry/acme/social-agent/>;
    interop:hasApplicationRegistry <https://registry/acme/application/>;
    interop:hasInvitationRegistry <https://registry/acme/invitation/>;
    interop:hasAuthorizationRegistry <https://registry/acme/authorization/>;
    interop:hasGrantRegistry <https://registry/acme/grant/>;
    interop:hasRoleRegistry <https://registry/acme/role/>;
    interop:hasActivityRegistry <https://registry/acme/activity/>;
    interop:hasAccessRequestRegistry <https://registry/acme/access-request/>;
    interop:hasDataRegistry
      <https://data/acme-rnd/>,
      <https://data/acme-hr/>.
}

