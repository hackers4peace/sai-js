}

GRAPH <meta:https://registry/acme/social-agent/je0s7n/.acr> {
        <https://registry/acme/social-agent/je0s7n/.acr> a ldp:Resource .
}

GRAPH <https://registry/acme/social-agent/je0s7n/.acr> {
  <https://registry/acme/social-agent/je0s7n/.acr#root>
    a acp:AccessControlResource;
    acp:resource <https://registry/acme/social-agent/je0s7n/>;
    acp:accessControl
      <https://registry/acme/social-agent/je0s7n/.acr#fullOwnerAccess>,
      <https://registry/acme/social-agent/je0s7n/.acr#peerReadAccess>;
    acp:memberAccessControl
      <https://registry/acme/social-agent/je0s7n/.acr#fullOwnerAccess>,
      <https://registry/acme/social-agent/je0s7n/.acr#peerReadAccess>.

  <https://registry/acme/social-agent/je0s7n/.acr#fullOwnerAccess>
    a acp:AccessControl;
    acp:apply [
      a acp:Policy;
      acp:allow acl:Read, acl:Write, acl:Control;
      acp:anyOf [
        a acp:Matcher;
        acp:agent <https://id/acme>;
        acp:client <https://auth/.sai/agents/aHR0cHM6Ly9pZC9hY21l>
      ]
    ].

  <https://registry/acme/social-agent/je0s7n/.acr#peerReadAccess>
    a acp:AccessControl;
    acp:apply [
      a acp:Policy;
      acp:allow acl:Read;
      acp:anyOf [
        a acp:Matcher;
        acp:agent <https://id/alice>;
        acp:client <https://auth/.sai/agents/aHR0cHM6Ly9pZC9hbGljZQ>
      ]
    ].
}

