    interop:inAccessDescriptionSet <https://data/test-client/public/descriptions-en> ;
    interop:hasAccessNeed <https://data/test-client/public/access-needs#need-image> ;
    skos:prefLabel "Access to Images allows Projectron to identify and manage the work to be done in a given Project."@en .

  <https://data/test-client/public/descriptions-en#en-need-file>
    a interop:AccessNeedDescription ;
    interop:inAccessDescriptionSet <https://data/test-client/public/descriptions-en> ;
    interop:hasAccessNeed <https://data/test-client/public/access-needs#need-file> ;
    skos:prefLabel "Access to Files allows Projectron to identify and manage the work to be done in a given Project."@en .
