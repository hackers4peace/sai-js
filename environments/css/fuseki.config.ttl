# Per-pod Fuseki datasets (openwiki/architecture/storage-isolation.md).
# Generated from environments/data/registry.trig + kv.json — do not hand-edit.
# Datasets: id, data-acme-hr, data-acme-rnd, data-alice-home, data-alice-work, data-bob, data-dan-east, data-dan-west, data-kim-blue, data-kim-red, data-shapetrees, data-test-client, data-yoyo-eu, data-yoyo-na, reg-acme, reg-alice, reg-bob, reg-dan, reg-kim, reg-yoyo

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2:   <http://jena.apache.org/2016/tdb#> .

<#id> rdf:type fuseki:Service ;
    fuseki:name "id" ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp_rw ; fuseki:name "data" ] ;
    fuseki:dataset <#id-dataset> .

<#id-dataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki-base/databases/id" .

