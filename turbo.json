{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["test/**/*-test.ts"],
      "cache": false
    },
    "lint": {},
    "dev": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "publish:npm": {
      "dependsOn": ["^publish:npm"],
      "cache": false,
      "env": ["NODE_AUTH_TOKEN", "NPM_TAG", "NPM_CONFIG_USERCONFIG"]
    }
  }
}
