!devbox.*
node_modules/
yarn.lock
# Garage state. Only the node identity (node_key[.pub]) and the applied layout
# (cluster_layout) need to be committed; everything else (db, data_layout, the
# data-dir marker, runtime state) is regenerated on start. See
# environments/garage/README or openwiki/architecture/storage-isolation.md.
environments/garage/meta/*
environments/garage/data/*
!environments/garage/meta/.gitkeep
!environments/garage/meta/cluster_layout
!environments/garage/meta/node_key
!environments/garage/meta/node_key.pub
!environments/garage/data/.gitkeep

dist/
dev-dist/
tsconfig.tsbuildinfo
.rollup.cache

# OS
.DS_Store

# logs
*.log

# local env files
.env.local
.env.*.local

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.turbo

environments/dev/traefik/certs/*


# Playwright
playwright-report/
test-results/
